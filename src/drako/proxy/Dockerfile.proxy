FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir "drako[proxy]" && \
    useradd --create-home --shell /bin/bash drako && \
    chown -R drako:drako /app

COPY --chown=drako:drako .drako.yaml /app/.drako.yaml

USER drako

ENV DRAKO_PROXY_HOST=0.0.0.0 \
    DRAKO_PROXY_PORT=8990 \
    DRAKO_CONFIG_PATH=/app/.drako.yaml

EXPOSE 8990

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD python -c "import os, urllib.request; port = os.environ.get('DRAKO_PROXY_PORT', '8990'); urllib.request.urlopen(f'http://127.0.0.1:{port}/health', timeout=3)" || exit 1

CMD ["python", "-m", "drako.proxy"]
