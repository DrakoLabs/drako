{
  "$defs": {
    "A2AChannelRuleConfig": {
      "properties": {
        "from": {
          "default": "*",
          "title": "From",
          "type": "string"
        },
        "to": {
          "default": "*",
          "title": "To",
          "type": "string"
        },
        "allowed_message_types": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Message Types",
          "type": "array"
        },
        "max_payload_size_kb": {
          "default": 500,
          "title": "Max Payload Size Kb",
          "type": "integer"
        },
        "require_intent_verification": {
          "default": false,
          "title": "Require Intent Verification",
          "type": "boolean"
        },
        "policy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy"
        }
      },
      "title": "A2AChannelRuleConfig",
      "type": "object"
    },
    "A2AConfig": {
      "properties": {
        "mode": {
          "default": "enforce",
          "title": "Mode",
          "type": "string"
        },
        "require_signed_cards": {
          "default": true,
          "title": "Require Signed Cards",
          "type": "boolean"
        },
        "trusted_pubkeys_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trusted Pubkeys Dir"
        },
        "channels": {
          "items": {
            "$ref": "#/$defs/A2AChannelRuleConfig"
          },
          "title": "Channels",
          "type": "array"
        },
        "worm_detection": {
          "$ref": "#/$defs/A2AWormDetectionConfig"
        }
      },
      "title": "A2AConfig",
      "type": "object"
    },
    "A2AWormDetectionConfig": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "scan_inter_agent_messages": {
          "default": true,
          "title": "Scan Inter Agent Messages",
          "type": "boolean"
        },
        "max_propagation_depth": {
          "default": 3,
          "title": "Max Propagation Depth",
          "type": "integer"
        },
        "circular_reference_block": {
          "default": true,
          "title": "Circular Reference Block",
          "type": "boolean"
        },
        "block_suspicious": {
          "default": false,
          "title": "Block Suspicious",
          "type": "boolean"
        }
      },
      "title": "A2AWormDetectionConfig",
      "type": "object"
    },
    "AgentEntry": {
      "properties": {
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        }
      },
      "title": "AgentEntry",
      "type": "object"
    },
    "AuditConfig": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "cryptographic": {
          "default": true,
          "title": "Cryptographic",
          "type": "boolean"
        },
        "receipt_store": {
          "default": ".drako/receipts.jsonl",
          "title": "Receipt Store",
          "type": "string"
        },
        "retention_days": {
          "default": 90,
          "title": "Retention Days",
          "type": "integer"
        }
      },
      "title": "AuditConfig",
      "type": "object"
    },
    "CircuitBreakerAgentConfig": {
      "properties": {
        "failure_threshold": {
          "default": 10,
          "title": "Failure Threshold",
          "type": "integer"
        },
        "time_window_seconds": {
          "default": 300,
          "title": "Time Window Seconds",
          "type": "integer"
        },
        "recovery_timeout_seconds": {
          "default": 60,
          "title": "Recovery Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "CircuitBreakerAgentConfig",
      "type": "object"
    },
    "CircuitBreakerConfig": {
      "properties": {
        "agent_level": {
          "$ref": "#/$defs/CircuitBreakerAgentConfig"
        }
      },
      "title": "CircuitBreakerConfig",
      "type": "object"
    },
    "DLPConfig": {
      "properties": {
        "mode": {
          "default": "audit",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "DLPConfig",
      "type": "object"
    },
    "EgressConfig": {
      "description": "Outbound network SSRF allowlist enforced by drako.kernel.egress.",
      "properties": {
        "allowed_domains": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Domains",
          "type": "array"
        }
      },
      "title": "EgressConfig",
      "type": "object"
    },
    "FallbackConfig": {
      "properties": {
        "mode": {
          "default": "off",
          "title": "Mode",
          "type": "string"
        },
        "tools": {
          "additionalProperties": {
            "$ref": "#/$defs/FallbackToolConfig"
          },
          "title": "Tools",
          "type": "object"
        },
        "default": {
          "$ref": "#/$defs/FallbackDefaultConfig"
        }
      },
      "title": "FallbackConfig",
      "type": "object"
    },
    "FallbackDefaultConfig": {
      "properties": {
        "fallback_action": {
          "default": "escalate_human",
          "title": "Fallback Action",
          "type": "string"
        },
        "preserve_state": {
          "default": true,
          "title": "Preserve State",
          "type": "boolean"
        },
        "state_ttl_hours": {
          "default": 24,
          "title": "State Ttl Hours",
          "type": "integer"
        }
      },
      "title": "FallbackDefaultConfig",
      "type": "object"
    },
    "FallbackToolConfig": {
      "properties": {
        "fallback_script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Script"
        },
        "fallback_agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Agent"
        },
        "fallback_action": {
          "default": "escalate_human",
          "title": "Fallback Action",
          "type": "string"
        },
        "safe_default": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Safe Default"
        },
        "triggers": {
          "items": {
            "type": "string"
          },
          "title": "Triggers",
          "type": "array"
        }
      },
      "title": "FallbackToolConfig",
      "type": "object"
    },
    "FinOpsBudgetConfig": {
      "properties": {
        "daily_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Daily Usd"
        },
        "weekly_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weekly Usd"
        },
        "monthly_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monthly Usd"
        },
        "alert_at_percent": {
          "items": {
            "type": "integer"
          },
          "title": "Alert At Percent",
          "type": "array"
        }
      },
      "title": "FinOpsBudgetConfig",
      "type": "object"
    },
    "FinOpsConfig": {
      "properties": {
        "tracking": {
          "$ref": "#/$defs/FinOpsTrackingConfig"
        },
        "budgets": {
          "$ref": "#/$defs/FinOpsBudgetConfig"
        }
      },
      "title": "FinOpsConfig",
      "type": "object"
    },
    "FinOpsTrackingConfig": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "model_costs": {
          "additionalProperties": {
            "$ref": "#/$defs/ModelCostConfig"
          },
          "title": "Model Costs",
          "type": "object"
        }
      },
      "title": "FinOpsTrackingConfig",
      "type": "object"
    },
    "HITLConfig": {
      "properties": {
        "mode": {
          "default": "enforce",
          "title": "Mode",
          "type": "string"
        },
        "triggers": {
          "$ref": "#/$defs/HITLTriggersConfig"
        },
        "approval_timeout_minutes": {
          "default": 30,
          "title": "Approval Timeout Minutes",
          "type": "integer"
        },
        "timeout_action": {
          "default": "reject",
          "title": "Timeout Action",
          "type": "string"
        }
      },
      "title": "HITLConfig",
      "type": "object"
    },
    "HITLTriggersConfig": {
      "properties": {
        "tool_types": {
          "items": {
            "type": "string"
          },
          "title": "Tool Types",
          "type": "array"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        },
        "trust_score_below": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Trust Score Below"
        },
        "spend_above_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spend Above Usd"
        },
        "records_above": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Records Above"
        },
        "first_time_tool": {
          "default": false,
          "title": "First Time Tool",
          "type": "boolean"
        },
        "first_time_action": {
          "default": false,
          "title": "First Time Action",
          "type": "boolean"
        }
      },
      "title": "HITLTriggersConfig",
      "type": "object"
    },
    "HookEntryConfig": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "timeout_ms": {
          "default": 5000,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "action_on_fail": {
          "default": "block",
          "title": "Action On Fail",
          "type": "string"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        }
      },
      "required": [
        "name"
      ],
      "title": "HookEntryConfig",
      "type": "object"
    },
    "HooksConfig": {
      "properties": {
        "pre_action": {
          "items": {
            "$ref": "#/$defs/HookEntryConfig"
          },
          "title": "Pre Action",
          "type": "array"
        },
        "post_action": {
          "items": {
            "$ref": "#/$defs/HookEntryConfig"
          },
          "title": "Post Action",
          "type": "array"
        },
        "on_error": {
          "items": {
            "$ref": "#/$defs/HookEntryConfig"
          },
          "title": "On Error",
          "type": "array"
        },
        "on_session_end": {
          "items": {
            "$ref": "#/$defs/HookEntryConfig"
          },
          "title": "On Session End",
          "type": "array"
        }
      },
      "title": "HooksConfig",
      "type": "object"
    },
    "IntentRequiredForConfig": {
      "properties": {
        "tool_types": {
          "items": {
            "type": "string"
          },
          "title": "Tool Types",
          "type": "array"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "title": "IntentRequiredForConfig",
      "type": "object"
    },
    "IntentVerificationConfig": {
      "properties": {
        "mode": {
          "default": "enforce",
          "title": "Mode",
          "type": "string"
        },
        "required_for": {
          "$ref": "#/$defs/IntentRequiredForConfig"
        },
        "anti_replay": {
          "default": true,
          "title": "Anti Replay",
          "type": "boolean"
        },
        "intent_ttl_seconds": {
          "default": 300,
          "title": "Intent Ttl Seconds",
          "type": "integer"
        }
      },
      "title": "IntentVerificationConfig",
      "type": "object"
    },
    "KernelConfig": {
      "description": "Authority Kernel configuration (AGENT-HOOKS-0.1).",
      "properties": {
        "spec_pin": {
          "default": "AGENT-HOOKS-0.1",
          "title": "Spec Pin",
          "type": "string"
        },
        "default_effect": {
          "default": "deny",
          "title": "Default Effect",
          "type": "string"
        },
        "profile_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Path"
        },
        "receipt_store": {
          "default": ".drako/receipts.jsonl",
          "title": "Receipt Store",
          "type": "string"
        },
        "operator_pubkey_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator Pubkey Path"
        },
        "tiers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tiers",
          "type": "object"
        }
      },
      "title": "KernelConfig",
      "type": "object"
    },
    "LoopBreakerConfig": {
      "description": "Runaway repetition circuit-breaker (OWASP ASI08/ASI10).",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "trip_threshold": {
          "default": 10,
          "title": "Trip Threshold",
          "type": "integer"
        },
        "window_seconds": {
          "default": 300.0,
          "title": "Window Seconds",
          "type": "number"
        }
      },
      "title": "LoopBreakerConfig",
      "type": "object"
    },
    "MCPConfig": {
      "description": "MCP supply-chain & runtime guard configuration.",
      "properties": {
        "lockfile": {
          "default": "mcp.lock",
          "title": "Lockfile",
          "type": "string"
        },
        "enforce_pin": {
          "default": true,
          "title": "Enforce Pin",
          "type": "boolean"
        },
        "env_allowlist": {
          "items": {
            "type": "string"
          },
          "title": "Env Allowlist",
          "type": "array"
        },
        "allow_auto_install": {
          "default": false,
          "title": "Allow Auto Install",
          "type": "boolean"
        },
        "protocol_version": {
          "default": "2026-07-28",
          "title": "Protocol Version",
          "type": "string"
        }
      },
      "title": "MCPConfig",
      "type": "object"
    },
    "ModelCostConfig": {
      "properties": {
        "input": {
          "default": 0.0,
          "title": "Input",
          "type": "number"
        },
        "output": {
          "default": 0.0,
          "title": "Output",
          "type": "number"
        }
      },
      "title": "ModelCostConfig",
      "type": "object"
    },
    "ProxyConfig": {
      "description": "Local enforcement proxy settings (loopback-only by default).",
      "properties": {
        "host": {
          "default": "127.0.0.1",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 8990,
          "title": "Port",
          "type": "integer"
        },
        "cors_origins": {
          "items": {
            "type": "string"
          },
          "title": "Cors Origins",
          "type": "array"
        }
      },
      "title": "ProxyConfig",
      "type": "object"
    },
    "ToolEntry": {
      "properties": {
        "source": {
          "default": "",
          "title": "Source",
          "type": "string"
        },
        "type": {
          "default": "read",
          "title": "Type",
          "type": "string"
        }
      },
      "title": "ToolEntry",
      "type": "object"
    }
  },
  "description": "Root `.drako.yaml` schema for Drako v4 (100% local-first).",
  "properties": {
    "version": {
      "default": "4.0",
      "title": "Version",
      "type": "string"
    },
    "project_id": {
      "default": "default",
      "title": "Project Id",
      "type": "string"
    },
    "tenant_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tenant Id"
    },
    "governance_level": {
      "default": "balanced",
      "title": "Governance Level",
      "type": "string"
    },
    "extends": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extends"
    },
    "framework": {
      "default": "generic",
      "title": "Framework",
      "type": "string"
    },
    "kernel": {
      "$ref": "#/$defs/KernelConfig"
    },
    "loop_breaker": {
      "$ref": "#/$defs/LoopBreakerConfig"
    },
    "agents": {
      "additionalProperties": {
        "$ref": "#/$defs/AgentEntry"
      },
      "title": "Agents",
      "type": "object"
    },
    "detected_tools": {
      "additionalProperties": {
        "$ref": "#/$defs/ToolEntry"
      },
      "title": "Detected Tools",
      "type": "object"
    },
    "dlp": {
      "$ref": "#/$defs/DLPConfig"
    },
    "circuit_breaker": {
      "$ref": "#/$defs/CircuitBreakerConfig"
    },
    "audit": {
      "$ref": "#/$defs/AuditConfig"
    },
    "hitl": {
      "$ref": "#/$defs/HITLConfig"
    },
    "intent_verification": {
      "$ref": "#/$defs/IntentVerificationConfig"
    },
    "hooks": {
      "$ref": "#/$defs/HooksConfig"
    },
    "finops": {
      "$ref": "#/$defs/FinOpsConfig"
    },
    "fallback": {
      "$ref": "#/$defs/FallbackConfig"
    },
    "a2a": {
      "$ref": "#/$defs/A2AConfig"
    },
    "mcp": {
      "$ref": "#/$defs/MCPConfig"
    },
    "egress": {
      "$ref": "#/$defs/EgressConfig"
    },
    "proxy": {
      "$ref": "#/$defs/ProxyConfig"
    }
  },
  "title": "DrakoConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DrakoLabs/drako/main/schema/drako-config.schema.json"
}
